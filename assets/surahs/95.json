{"code":200,"status":"OK","data":[{"number":95,"name":"سُورَةُ التِّينِ","englishName":"At-Tin","englishNameTranslation":"The Fig","revelationType":"Meccan","ayahs":[{"number":6099,"text":"وَٱلتِّينِ وَٱلزَّيْتُونِ","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6100,"text":"وَطُورِ سِينِينَ","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6101,"text":"وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6102,"text":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6103,"text":"ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَ��فِلِينَ","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6104,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6105,"text":"فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6106,"text":"أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran"}},{"number":95,"name":"سُورَةُ التِّينِ","englishName":"At-Tin","englishNameTranslation":"The Fig","revelationType":"Meccan","ayahs":[{"number":6099,"text":"İncir ve zeytine and olsun,","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6100,"text":"And olsun Sina dağına,","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6101,"text":"And olsun bu güvenli Mekke şehrine ki:","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6102,"text":"Biz insanı en güzel şekilde yarattık,","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6103,"text":"Sonra onu aşağıların en aşağısı kıldık.","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6104,"text":"Yalnız, inanıp yararlı iş işleyenler bunun dışındadır. Onlara kesintisiz ecir vardır.","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6105,"text":"Öyleyken, sana dini yalan saydırtan nedir?","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6106,"text":"Allah, hükmedenlerin en iyi hükmedeni değil midir?","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}]}