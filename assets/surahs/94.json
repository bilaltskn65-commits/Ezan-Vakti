{"code":200,"status":"OK","data":[{"number":94,"name":"سُورَةُ الشَّرۡحِ","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","revelationType":"Meccan","ayahs":[{"number":6091,"text":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6092,"text":"وَوَضَعْنَا عَنكَ وِزْرَكَ","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6093,"text":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6094,"text":"وَرَفَعْنَا لَكَ ذِكْرَكَ","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6095,"text":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6096,"text":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6097,"text":"فَإِذَا فَرَغْتَ فَٱنصَبْ","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6098,"text":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran"}},{"number":94,"name":"سُورَةُ الشَّرۡحِ","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","revelationType":"Meccan","ayahs":[{"number":6091,"text":"Senin gönlünü açmadık mı?","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6092,"text":"Belini büken yükünü üzerinden almadık mı?","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6093,"text":"Belini büken yükünü üzerinden almadık mı?","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6094,"text":"Senin şanını yükseltmedik mi?","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6095,"text":"Elbette güçlükle beraber şüphesiz bir kolaylık vardır.","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6096,"text":"Gerçekten, güçlükle beraber bir kolaylık vardır.","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6097,"text":"Öyleyse, bir işi bitirince diğerine giriş;","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6098,"text":"Ve ümit edeceğini yalnız Rabbinden iste.","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}]}