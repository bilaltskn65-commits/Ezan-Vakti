nglishName":"Uthmani","format":"text","type":"quran"}},{"number":77,"name":"سُورَةُ المُرۡسَلَاتِ","englishName":"Al-Mursalaat","englishNameTranslation":"The Emissaries","revelationType":"Meccan","ayahs":[{"number":5623,"text":"Birbiri ardından gönderilenlere ve görevlerine koştukça koşanlara, Allah'ın buyruklarını yaydıkça yayanlara ve hak ile batılın arasını ayırdıkça ayıranlara, kötülüğü önlemek veya uyarmak için vahiy getiren meleklere and olsun ki, size söz verilen kıyamet şüphesiz kopacaktır.","numberInSurah":1,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5624,"text":"Birbiri ardından gönderilenlere ve görevlerine koştukça koşanlara, Allah'ın buyruklarını yaydıkça yayanlara ve hak ile batılın arasını ayırdıkça ayıranlara, kötülüğü önlemek veya uyarmak için vahiy getiren meleklere and olsun ki, size söz verilen kıyamet şüphesiz kopacaktır.","numberInSurah":2,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5625,"text":"Birbiri ardından gönderilenlere ve görevlerine koştukça koşanlara, Allah'ın buyruklarını yaydıkça yayanlara ve hak ile batılın arasını ayırdıkça ayıranlara, kötülüğü önlemek veya uyarmak için vahiy getiren meleklere and olsun ki, size söz verilen kıyamet şüphesiz kopacaktır.","numberInSurah":3,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5626,"text":"Birbiri ardından gönderilenlere ve görevlerine koştukça koşanlara, Allah'ın buyruklarını yaydıkça yayanlara ve hak ile batılın arasını ayırdıkça ayıranlara, kötülüğü önlemek veya uyarmak için vahiy getiren meleklere and olsun ki, size söz verilen kıyamet şüphesiz kopacaktır.","numberInSurah":4,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5627,"text":"Birbiri ardından gönderilenlere ve görevlerine koştukça koşanlara, Allah'ın buyruklarını yaydıkça yayanlara ve hak ile batılın arasını ayırdıkça ayıranlara, kötülüğü önlemek veya uyarmak için vahiy getiren meleklere and olsun ki, size söz verilen kıyamet şüphesiz kopacaktır.","numberInSurah":5,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5628,"text":"Birbiri ardından gönderilenlere ve görevlerine koştukça koşanlara, Allah'ın buyruklarını yaydıkça yayanlara ve hak ile batılın arasını ayırdıkça ayıranlara, kötülüğü önlemek veya uyarmak için vahiy getiren meleklere and olsun ki, size söz verilen kıyamet şüphesiz kopacaktır.","numberInSurah":6,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5629,"text":"Birbiri ardından gönderilenlere ve görevlerine koştukça koşanlara, Allah'ın buyruklarını yaydıkça yayanlara ve hak ile batılın arasını ayırdıkça ayıranlara, kötülüğü önlemek veya uyarmak için vahiy getiren meleklere and olsun ki, size söz verilen kıyamet şüphesiz kopacaktır.","numberInSurah":7,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5630,"text":"Yıldızların ışığı giderildiği zaman,","numberInSurah":8,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5631,"text":"Gök yarıldığı zaman,","numberInSurah":9,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5632,"text":"Dağlar pamuk gibi atıldığı zaman,","numberInSurah":10,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5633,"text":"Peygamberlere ümmetleri hakkında şahidlik vakitleri bildirildiği zaman;","numberInSurah":11,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5634,"text":"Bu, hangi güne bırakılmıştı?","numberInSurah":12,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5635,"text":"Hüküm gününe bırakılmıştı.","numberInSurah":13,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5636,"text":"Hüküm gününün ne olduğunu sen nerden bilirsin?","numberInSurah":14,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5637,"text":"O gün yalanlamış olanların vay haline!","numberInSurah":15,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5638,"text":"Öncekileri yok etmedik mi? Ardından, sonrakileri de onlara katarız.","numberInSurah":16,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5639,"text":"Öncekileri yok etmedik mi? Ardından, sonrakileri de onlara katarız.","numberInSurah":17,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5640,"text":"Suçlulara böyle yaparız.","numberInSurah":18,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5641,"text":"O gün, yalanlamış olanların vay haline!.","numberInSurah":19,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5642,"text":"Sizi bayağı bir sudan yaratıp onu belli bir süreye kadar sağlam bir yere yerleştirmedik mi?","numberInSurah":20,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5643,"text":"Sizi bayağı bir sudan yaratıp onu belli bir süreye kadar sağlam bir yere yerleştirmedik mi?","numberInSurah":21,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5644,"text":"Sizi bayağı bir sudan yaratıp onu belli bir süreye kadar sağlam bir yere yerleştirmedik mi?","numberInSurah":22,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5645,"text":"Buna gücümüz yeter; Biz ne güzel güç yetireniz!","numberInSurah":23,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5646,"text":"O gün yalanlamış olanların vay haline!","numberInSurah":24,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5647,"text":"Biz yeryüzünü, dirilerin ve ölülerin toplantı yeri yapmadık mı?","numberInSurah":25,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5648,"text":"Biz yeryüzünü, dirilerin ve ölülerin toplantı yeri yapmadık mı?","numberInSurah":26,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5649,"text":"Orada yüksek yüksek sabit dağlar var edip size tatlı sular içirmedik mi?","numberInSurah":27,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5650,"text":"Yalanlamış olanların vay o gün haline!","numberInSurah":28,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5651,"text":"İnkarcılara o gün şöyle denir: \"yalanlayıp durduğunuz şeye gidin;\"","numberInSurah":29,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5652,"text":"\"gölge yapmayan ve ateşten de korumayan cehennem dumanının üç kollu gölgesine gidin.\"","numberInSurah":30,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5653,"text":"\"gölge yapmayan ve ateşten de korumayan cehennem dumanının üç kollu gölgesine gidin.\"","numberInSurah":31,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5654,"text":"O gölgenin saçtığı her bir kıvılcım sanki birer sarı devedir, konak gibi de büyüktür.","numberInSurah":32,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5655,"text":"O gölgenin saçtığı her bir kıvılcım sanki birer sarı devedir, konak gibi de büyüktür.","numberInSurah":33,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5656,"text":"Yalanlamış olanların o gün vay haline!","numberInSurah":34,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5657,"text":"Bu, onların konuşamayacakları gündür.","numberInSurah":35,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5658,"text":"Onlara izin de verilmez ki özür beyan etsinler.","numberInSurah":36,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5659,"text":"Yalanlamış olanların o gün vay haline!","numberInSurah":37,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5660,"text":"\"Bu, sizleri ve öncekileri topladığımız hüküm günüdür.\"","numberInSurah":38,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5661,"text":"\"Eğer bir düzeniniz varsa Bana kurun.\"","numberInSurah":39,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5662,"text":"Yalanlamış olanların o gün vay haline!.","numberInSurah":40,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5663,"text":"Allah'a karşı gelmekten sakınmış olanlar, elbette gölgeliklerde ve pınar başlarındadırlar.","numberInSurah":41,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5664,"text":"Canlarının istediği meyveler arasındadırlar.","numberInSurah":42,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5665,"text":"Onlara denir ki: \"İşlediklerinize karşılık afiyetle yiyiniz, içiniz.\"","numberInSurah":43,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5666,"text":"Biz, iyi davrananlara işte böyle karşılık veririz.","numberInSurah":44,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5667,"text":"O gün yalanlamış olanların vay haline","numberInSurah":45,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5668,"text":"Yiyiniz, biraz zevkleniniz bakalım, doğrusu sizler suçlularsınız.","numberInSurah":46,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5669,"text":"O gün yalanlamış olanların vay haline!","numberInSurah":47,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5670,"text":"Onlara \"Rüku edin\" denildiğinde rükua varmazlar.","numberInSurah":48,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5671,"text":"O gün yalanlamış olanların vay haline!","numberInSurah":49,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5672,"text":"Kuran'dan başka hangi söze inanacaklar?","numberInSurah":50,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}]}